# Copiar a .env y completar. NUNCA commitear el .env real (ver .gitignore raíz).
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USER=esp32
# Contraseña EN TEXTO PLANO (no el hash de mosquitto_passwd) — ver nota en el
# .env.example de la raíz del repo sobre por qué esto importa con Docker Compose.
MQTT_PASSWORD=CAMBIAR_por_la_misma_password_del_usuario_esp32_en_mosquitto_passwd

# Segundos entre detecciones automáticas de caja. 0 = solo detección manual (ENTER).
SIM_BOX_INTERVAL_S=25
